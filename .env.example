# Required
BOT_TOKEN=your_telegram_bot_token
ADMIN_IDS=your_telegram_user_id,another_admin_user_id
OLLAMA_HOST=http://localhost:11434

# Optional
# Update delivery: polling (default) or webhook
BOT_MODE=polling
# Required when BOT_MODE=webhook - public HTTPS URL registered with Telegram
# WEBHOOK_URL=https://your.domain/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8081
WEBHOOK_PATH=/webhook
# WEBHOOK_SECRET=some-shared-secret
# Bearer token for LiteLLM or other authenticated Ollama-compatible endpoints
# OLLAMA_API_KEY=your_litellm_key
DATABASE_URL=sqlite:///data/bot.db
TEST_MODE=false
LOG_LEVEL=INFO

MAX_CONTEXT_TOKENS=3000
OLLAMA_KEEP_ALIVE=10m
# Оставьте закомментированными, чтобы использовать значения самой модели
# OLLAMA_TEMPERATURE=0.7
# OLLAMA_NUM_CTX=8192
